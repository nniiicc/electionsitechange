{
"text": "🎉 Events Team Help plan and run town halls, signature drives, community gatherings, and fundraisers. If you love logistics and bringing people together, this team needs you.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
},
{
"text": "📋 Signature Gathering Team Collect petition signatures at events, farmers markets, places of worship, and high traffic locations. This is our most urgent need right now.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
},
{
"text": "📞 Phone Bank Team Make calls from anywhere. Reach voters across the district, gather support data, and help identify new volunteers from your own home.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
},
{
"text": "📣 Digital Team Share content, create posts, and amplify Dr. Kumar's message online. Perfect if you have strong social media skills and limited time for in person shifts.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
},
{
"text": "🚶 Canvass Team Hit the doors in your neighborhood. Talk to voters face to face, share Dr. Kumar's story, and build support one conversation at a time.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
},
{
"text": "🤝 Relational Organizing Team Use your personal network to reach voters who already trust you. Map your contacts, start conversations with friends and family, and multiply our reach through real relationships.",
"href": "https://docs.google.com/document/d/1J_6tpUPqtXnkctezOLME4kHicf5qaEG2/edit?usp=sharing&ouid=105620226410214625938&rtpof=true&sd=true"
}
]
